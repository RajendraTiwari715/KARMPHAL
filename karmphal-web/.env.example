# Backend API Base URL for Karmphal Web & Capacitor Mobile Builds
# - For local web dev: leave empty to use Vite dev proxy (`/api` -> `http://localhost:5000`)
# - For Android Emulator build: `http://10.0.2.2:5000`
# - For Production Web / Mobile: `https://api.yourdomain.com`
VITE_API_BASE_URL=http://localhost:5000
