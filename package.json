{
  "name": "karmphal",
  "version": "1.0.0",
  "description": "Karmphal - Vedic Ephemeris & Spiritual Life-Management System",
  "private": true,
  "scripts": {
    "dev": "npm --prefix karmphal-web run dev",
    "dev:web": "npm --prefix karmphal-web run dev",
    "dev:backend": "npm --prefix karmphal-backend run dev",
    "build": "npm --prefix karmphal-web run build",
    "test": "npm --prefix karmphal-backend run test",
    "lint": "npm --prefix karmphal-web run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "karmphal-web/**/*.{js,jsx}": [
      "npx --prefix karmphal-web oxlint"
    ],
    "karmphal-backend/**/*.js": [
      "npx --prefix karmphal-web oxlint"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
