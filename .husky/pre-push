echo "🔍 [pre-push] Running CI quality checks before push..."

# 1. Lint root (uses .eslintignore to exclude third-party/public/dist/android files)
echo ""
echo "⚙️  Oxlint — root..."
npx oxlint --deny-warnings || { echo "❌ Root oxlint failed. Fix all warnings before pushing."; exit 1; }

# 2. Lint backend
echo ""
echo "⚙️  Oxlint — backend..."
npx --prefix karmphal-backend oxlint --deny-warnings || { echo "❌ Backend oxlint failed."; exit 1; }

# 3. Lint frontend src only (avoids public/pdfjs-wasm minified files)
echo ""
echo "⚙️  Oxlint — frontend src..."
npx --prefix karmphal-web oxlint karmphal-web/src --deny-warnings || { echo "❌ Frontend oxlint failed."; exit 1; }

# 4. Backend tests
echo ""
echo "🧪 Backend tests..."
npm --prefix karmphal-backend run test || { echo "❌ Backend tests failed."; exit 1; }

# 5. Frontend tests
echo ""
echo "🧪 Frontend tests..."
npm --prefix karmphal-web run test || { echo "❌ Frontend tests failed."; exit 1; }

echo ""
echo "✅ [pre-push] All checks passed. Pushing..."
