# Karmphal Backend Environment Configuration Template
# Required & Optional Variables Validated by config/env.js

# Node Environment ('development' | 'production' | 'test') [Optional, default: development]
NODE_ENV=development

# Server Port [Optional, default: 5000]
PORT=5000

# SQLite Database Storage File Path [Optional, default: ./karmphal.db]
DB_PATH=./karmphal.db

# Cryptographic JWT Secret (Minimum 16 characters) [REQUIRED]
JWT_SECRET=your_jwt_secret_min_32_chars_long_here

# Google Gemini API Key [REQUIRED]
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated list) [REQUIRED]
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://karmphal.app

# Chat History Retention Limit Per User [Optional, default: 100]
CHAT_RETENTION_LIMIT=100

# AI Acharya Chat Hourly Rate Limit Per User / IP [Optional, default: 20]
AI_CHAT_RATE_LIMIT_HOUR=20

# AI Kundali OCR Hourly Rate Limit Per User / IP [Optional, default: 5]
AI_OCR_RATE_LIMIT_HOUR=5

# AI Daily Requests Quota Per User [Optional, default: 50]
AI_DAILY_QUOTA_PER_USER=50

# Maximum Output Tokens for Gemini Generation [Optional, default: 1500]
AI_MAX_OUTPUT_TOKENS=1500

# Global Daily Gemini AI Request Cap Across All Users (Returns 503 when reached) [Optional, default: 1000]
GLOBAL_DAILY_AI_LIMIT=1000

# Guest Account Minting Rate Limit Per IP Per Hour [Optional, default: 5]
GUEST_RATE_LIMIT_HOUR=5

# Legacy Token Migration Flag ('true' | 'false') [Optional, default: false]
LEGACY_MIGRATION_ENABLED=false

# Express Trust Proxy Hop Configuration ('1', 'loopback', or boolean) [Optional, default: 1 in production]
TRUST_PROXY=1
