{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Google Cloud / AI Studio API Key (AIza...)",
            "pattern": "/AIza[0-9A-Za-z_\\-]{30,}/"
          },
          {
            "name": "Google Gemini / Vertex AQ Token (AQ....)",
            "pattern": "/AQ\\.[0-9A-Za-z_\\-]{15,}/"
          },
          {
            "name": "OpenAI Secret Key (sk-...)",
            "pattern": "/sk-[0-9A-Za-z_\\-]{20,}/"
          },
          {
            "name": "Hardcoded Real JWT Secret",
            "pattern": "/JWT_SECRET\\s*[:=]\\s*['\"](?!your_jwt_secret|placeholder|min_32|test-mock)[^'\"\\r\\n]{16,}['\"]/"
          },
          {
            "name": "Exposed Frontend Gemini Key",
            "pattern": "/VITE_GEMINI[A-Za-z0-9_]*\\s*=\\s*['\"]?[A-Za-z0-9_.-]+['\"]?/"
          }
        ]
      }
    }
  ]
}
