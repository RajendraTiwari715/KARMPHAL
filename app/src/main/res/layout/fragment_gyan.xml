<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <TextView
        android:id="@+id/tvGyanHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="सम्पूर्ण धर्म ज्ञान एवं शास्त्र संग्रह"
        android:textColor="@color/secondary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp"
        android:background="@color/card_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toBottomOf="@id/tvGyanHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Divine Banner Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_margin="6dp"
                android:layout_marginBottom="12dp">
                
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/banner_vedas"
                        android:scaleType="centerCrop"
                        android:contentDescription="Vedas Banner" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#70000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="अगाध सनातन ज्ञान व दिव्य ग्रन्थ"
                        android:textColor="@color/secondary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:shadowColor="#FF000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="4" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category 1: Vedas, Upanishads & Darshana -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📜 १. वेद, उपनिषद एवं दर्शन शास्त्र"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVedas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_vedas" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="चार वेद (Vedas)" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ऋग, यजुः, साम, अथर्व" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUpanishads"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_gyan" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="108 उपनिषद" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ईश, केन, कठ, मुण्डक आदि" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDarshana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_gyan" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="षड्दर्शन (Darshana)" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="सांख्य, योग, न्याय, वेदांत" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Category 2: Epics & Sacred Puranas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔱 २. महाकाव्य एवं पवित्र पुराण"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGita"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_gita" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="श्रीमद्भगवद्गीता" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18 अध्याय • 700 श्लोक" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBhagavata"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_gyan" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="श्रीमद्भागवत पुराण" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 स्कंध • भक्ति रस" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRamayana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_ramayana" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="वाल्मीकि रामायण" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7 काण्ड • मर्यादा पुरुषोत्तम" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRamcharitmanas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_ramayana" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="रामचरितमानस" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="तुलसीदास जी रचित" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMahabharata"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_gita" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="महाभारत" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18 पर्व • व्यास मुनि" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShivaPuran"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_shiva" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="शिव पुराण" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="शिव महिमा एवं संहिताएँ" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Category 3: Niti Shastras & Ethics -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚖️ ३. नीतिशास्त्र एवं जीवन दर्शन"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVidur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_gyan" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="विदुर नीति" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="महाभारत उद्योग पर्व" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChanakya"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_gyan" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="चाणक्य नीति" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="कौटिल्य नीतिशास्त्र" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBhartrihari"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_gyan" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="भर्तृहरि नीतिशतक" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100 नीति उपदेश" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShukraNiti"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_gyan" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="शुक्र नीति" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="महर्षि शुक्राचार्य नीति" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Category 4: Stotrams & Chalisa -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕉️ ४. स्तोत्र, चालीसा एवं पाठ"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHanuman"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_hanuman" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="हनुमान चालीसा" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="बजरंग बाण व आरती" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShivaStotram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_shiva" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="शिव तांडव स्तोत्र" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="रुद्राष्टकम व महिम्न" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
