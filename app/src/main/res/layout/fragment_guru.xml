<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/card_bg"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_guru"
            app:tint="@color/secondary"
            android:layout_marginEnd="8dp"
            android:contentDescription="Guru Avatar" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="धर्ममाइंड गुरु (ज्योतिष, शास्त्र एवं कर्म AI)"
            android:textColor="@color/secondary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutChips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/layoutChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:background="@color/bg_dark"
        app:layout_constraintBottom_toTopOf="@id/layoutInput">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKundali"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔮 कुंडली फलादेश व ग्रह दशा"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_gold"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrayashchit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 पाप-अपराध प्रायश्चित्त विधान"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_gold"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGaruda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦅 गरुड़ पुराण एवं परलोक गति"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_gold"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThought"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ आज का सुविचार व श्लोक"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_gold"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKarma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️ संचित व प्रारब्ध कर्म शांति"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_gold"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:gravity="center_vertical"
        android:background="@color/card_bg"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="कुंडली, धर्म, शास्त्र या कर्म विधान पूछिए..."
            android:textColorHint="#88FFF5E1"
            android:textColor="@color/text_gold"
            android:background="@drawable/bg_chat_user"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:maxLines="4"/>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/primary"
            android:contentDescription="Send" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
