<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <TextView
        android:id="@+id/tvKarmaHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="कर्म विधान, गरुड़ पुराण एवं प्रायश्चित्त"
        android:textColor="@color/secondary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp"
        android:background="@color/card_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toBottomOf="@id/tvKarmaHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Karma Ledger Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:src="@drawable/banner_karma"
                        android:scaleType="centerCrop"
                        android:contentDescription="Karma Banner" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="कर्म लेखा-जोखा (Karma Accounting)"
                            android:textColor="@color/secondary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="मनुष्य का प्रत्येक विचार, शब्द और कार्य कर्म बही (Karma Ledger) में अंकित होता है। अपने शुभाशुभ कर्मों का मूल्यांकन करें।"
                            android:textColor="@color/text_gold"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnKarmaLedger"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="अपना कर्म खाता देखें (Check Karma Balance)"
                            app:backgroundTint="@color/primary"
                            android:textColor="@color/black"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Garuda Purana & Mysteries Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🦅 गरुड़ पुराण एवं परलोक शास्त्र"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <!-- Complete Garuda Puran -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGaruda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_garuda" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="सम्पूर्ण गरुड़ पुराण" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16 अध्याय • प्रेत कल्प व यमलोक" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Garuda Secrets -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGarudaSecrets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/banner_garuda" android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="गरुड़ पुराण के रहस्य" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="पाप-पुण्य फल व पुनर्जन्म गति" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Sin Diagnosis & Penance Atonement Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥 अपराध निदान एवं प्रायश्चित्त विधान"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <!-- Prayashchit Vidhan -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPrayashchit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_karma" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="प्रायश्चित्त विधान" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="पाप मुक्ति, दान व नियम" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Karma Fal Siddhant -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardKarmaSiddhant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_karma" app:tint="@color/secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="कर्म फल सिद्धांत" android:textColor="@color/secondary" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="संचित, प्रारब्ध व क्रियमाण" android:textColor="@color/text_subtle" android:textSize="11sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Result Card for Karma Calculation / Diagnosis -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKarmaResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/secondary"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvKarmaResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="@color/text_gold"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
